# Build output.
/target
# `nix build` leaves these symlinks into the store; cargo would package
# whatever git does not ignore.
/result
/result-*
# direnv's materialized environment.
/.direnv
# Agent worktrees. Each is a full checkout of this repo living inside it, so
# without this line one `git add -A` commits a copy of the tree into itself.
/.claude
# Coverage instrumentation dropped by the test runner.
*.profraw
