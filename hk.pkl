/// characterminator's gate, defined ONCE.
///
/// Every op below is a plain command a human can paste into a shell. hk
/// decides *when* they run; it never hides *what* runs, so a verdict never
/// rests on the runner's own logic.
///
/// The schema is VENDORED at `pkl/Config.pkl` rather than fetched from a
/// `package://` URL at eval time: the gate runs with no network.
amends "pkl/Config.pkl"

/// Success is silence. Output that always appears is output nobody reads,
/// which is how a real failure hides in noise everyone learned to scroll
/// past. Failure is loud and carries its own remediation.
fail_fast = true

env {
  ["HK_HIDE_WHEN_DONE"] = "true"
}

/// `depends` chains the cargo steps deliberately. Cargo takes a lock on the
/// target directory, so two cargo jobs launched in parallel do not run in
/// parallel: the second blocks on the build directory lock, which READS AS A
/// HANG. Chaining makes the serialization explicit and leaves hk free to run
/// the spec checks concurrently.
local fast = new Mapping<String, Step> {
  ["fmt"] {
    glob = List("**/*.rs")
    check = "cargo fmt --check"
    fix = "cargo fmt"
  }
  ["clippy"] {
    glob = List("**/*.rs")
    depends = List("fmt")
    check = "cargo clippy --all-targets -- -D warnings"
  }
  ["test"] {
    glob = List("**/*.rs")
    depends = List("clippy")
    check = "cargo test"
  }
  // THE DOGFOOD (V13). The tool gates its own tree, against the `.ctrm` and
  // `.ctrm-sets` beside this file -- so every grant this repo relies on is
  // one a user could write, and a preset that stopped working would fail
  // HERE before it failed for anybody else.
  //
  // It runs the tool from SOURCE rather than a binary on PATH: the thing
  // under test is this working tree, and a check that silently graded an
  // installed older build would be worse than no check.
  //
  // Chained after `test` for the target-directory lock reason above, and
  // because a tree whose tests fail has nothing to say about its own
  // characters yet.
  ["ctrm"] {
    glob = List("**/*")
    depends = List("test")
    check = """
      cargo run --quiet --bin ctrm -- check || { echo 'hk: a tracked file holds a character its set does not grant. Each line above is path:line:col, the code point, and the set it was judged against. Fix the character, or grant it in `.ctrm` -- a grant is a decision, so say why in the commit.' >&2; exit 1; }
      """
  }
  // THE SPEC FORM, checked by its OWNER. The format has one implementation
  // and this repo calls it rather than porting it. Every node's SPEC.md is
  // checked, not only the root: the federation put rules in one file per
  // node, and a rule nothing checks is decoration.
  //
  // It fails HARD when `mth` is absent rather than skipping: nothing else
  // checks SPEC.md structure, so a skip would read exactly like a pass.
  //
  // The specs are FOUND, not globbed one level deep: a node may have
  // sub-nodes (`src/cli/guard`), and `src/*/SPEC.md` would leave theirs
  // unchecked under a green gate. `find` also never hands the loop an
  // unmatched pattern as a literal file name.
  ["mth"] {
    glob = List("SPEC.md", "src/**/SPEC.md")
    check = """
      command -v mth >/dev/null 2>&1 || { echo 'hk: mth is not on PATH and nothing else checks SPEC.md structure. Enter the dev shell (`nix develop`, or `direnv reload`), which provides it from a pinned flake input.' >&2; exit 1; }
      for f in SPEC.md $(find src -name SPEC.md | sort); do
        mth fmt --check "$f" || { printf 'hk: %s is not formatted -- one line per statement, no line over the cap. Run `mth fmt %s`; splitting an over-long statement is the fix, raising the cap is a reviewed decision.\n' "$f" "$f" >&2; exit 1; }
      done
      """
  }
  // The other half: the STRUCTURAL rules. `mth fmt` says the file is shaped
  // right; this says it is still correct -- sections in order, ids unique,
  // citations resolving.
  //
  // A node's closed options are checked too: `mth` keys records by id and
  // ids repeat across specs, so each node keeps its own `.spec-records`
  // BESIDE its SPEC.md, and the loop passes it when it is there. A node
  // with nothing recorded has no file. Deleting one is a visible diff, the
  // same review a deleted line in the root file gets.
  ["mth-check"] {
    glob = List("SPEC.md", "src/**/SPEC.md", ".spec-records", "src/**/.spec-records")
    depends = List("mth")
    check = """
      mth check --records .spec-records SPEC.md || { echo "hk: SPEC.md failed its structural rules, or a decision .spec-records requires has gone missing. Each line above names the rule, the line, why it matters, and a ranked fix." >&2; exit 1; }
      for f in $(find src -name SPEC.md | sort); do
        records="$(dirname "$f")/.spec-records"
        if [ -f "$records" ]; then set -- --records "$records"; else set --; fi
        mth check "$@" "$f" || { echo "hk: $f failed its structural rules, or a decision its .spec-records requires has gone missing. Each line above names the rule, the line, why it matters, and a ranked fix." >&2; exit 1; }
      done
      """
  }
  // THE CEILINGS GET A RUNNER. `.context-limits` names a token budget for
  // every node and nothing else enforces it: a spec is re-read every turn, so
  // its size is a recurring bill rather than a one-off.
  //
  // Counting tokens here would mean a tokenizer -- a table or a dependency,
  // in a crate that has neither yet -- so this CALLS the tool that owns the
  // rule. `itok check` reads `.context-limits` itself and pins `--bpe`, so
  // the threshold lives in one file rather than being restated in this one.
  ["context-limits"] {
    glob = List("SPEC.md", "src/**/SPEC.md", ".context-limits")
    depends = List("mth-check")
    check = """
      command -v itok >/dev/null 2>&1 || { echo 'hk: itok is not on PATH, so the token ceilings were NOT checked -- re-enter the dev shell (`nix develop`, or `direnv reload`). Examined nothing; this is not a pass.' >&2; exit 1; }
      itok check || { echo 'hk: a spec is over the token ceiling .context-limits records. Compacting is the fix -- fold done task rows and old bug records; raising a ceiling is a reviewed decision and belongs in its own commit.' >&2; exit 1; }
      """
  }
  // THE FEDERATION. `sherd check` reads the whole node tree: every declared
  // resolves to a directory, sibling lenses stay disjoint, and no node
  // outgrows its ceiling.
  //
  // After `mth-check`, so a SPEC.md that is malformed is reported FIRST by
  // the format's owner, with its why-and-fix text. sherd parses the same
  // files, and under `fail_fast` its terser complaint about a broken file
  // would otherwise be the only line a contributor sees.
  ["sherd-check"] {
    glob = List("SPEC.md", "src/**/SPEC.md", "**/*.rs")
    depends = List("mth-check")
    check = """
      command -v sherd >/dev/null 2>&1 || { echo 'hk: sherd is not on PATH, so the federation was NOT checked -- re-enter the dev shell. Examined nothing; this is not a pass.' >&2; exit 1; }
      sherd check || { echo 'hk: sherd check found a structural violation -- it names the file, line and rule.' >&2; exit 1; }
      """
  }
  // THE CHAINS GET A RUNNER (T14, V16). `context-limits` caps each spec
  // FILE; this caps each node's CHAIN -- root + hub + node, which is what a
  // session working in that node actually loads. The ceilings are the
  // directory rows in `.context-limits`, read by longest matching prefix.
  //
  // It fails HARD when sherd is absent, for the reason every step here
  // does: a skip would read exactly like a pass.
  ["sherd-budget"] {
    glob = List("SPEC.md", "src/**/SPEC.md", ".context-limits")
    depends = List("sherd-check")
    check = """
      command -v sherd >/dev/null 2>&1 || { echo 'hk: sherd is not on PATH, so the chain budgets were NOT checked -- re-enter the dev shell. Examined nothing; this is not a pass.' >&2; exit 1; }
      sherd budget >/dev/null || { sherd budget >&2 || true; echo 'hk: a node chain is over its ceiling in .context-limits (the directory rows). Compacting the chain is the fix -- `mth archive` the finished rows; raising a ceiling is a reviewed decision and belongs in its own commit.' >&2; exit 1; }
      """
  }
  // THE CAP ON CEILINGS (V103). A ceiling below the cap rises by the ~12%
  // band like any other; a ceiling that would pass the cap means the node
  // has outgrown what one worker should hold, and the fix is a split, not
  // a bigger number. Directory rows are chain ceilings, `SPEC.md` rows are
  // file ceilings. Moving a cap is a change to V103 and to this step, in
  // its own reviewed commit.
  ["ceiling-cap"] {
    glob = List(".context-limits")
    check = """
      awk '
        /^#/ || NF < 2 { next }
        { seen++ }
        $1 ~ /SPEC[.]md$/ && $2 > 3500 { print ".context-limits: " $1 " " $2 " is over the 3500 file cap"; bad++ }
        $1 !~ /[.]md$/ && $2 > 5500 { print ".context-limits: " $1 " " $2 " is over the 5500 chain cap"; bad++ }
        END { if (seen == 0) { print ".context-limits: no row examined"; bad++ } exit bad > 0 }
      ' .context-limits >&2 || { echo 'hk: a ceiling is over its cap (V103). Split the node -- `sherd split <dir>` proposes one -- rather than raising the ceiling; moving the cap is its own reviewed change.' >&2; exit 1; }
      """
  }
  // The NAV section is GENERATED from the FEDERATION section above it, and
  // a generated section that had
  // to change means the committed tree was stale, so this reports rather
  // than rewrites: `sherd sync` is the fix, run deliberately.
  ["sherd-sync"] {
    glob = List("SPEC.md", "src/**/SPEC.md")
    depends = List("sherd-check")
    check = """
      command -v sherd >/dev/null 2>&1 || { echo 'hk: sherd is not on PATH, so NAV was NOT checked -- re-enter the dev shell. Examined nothing; this is not a pass.' >&2; exit 1; }
      sherd sync --check || { echo 'hk: a NAV section is stale against the FEDERATION section above it. Run `sherd sync`, then `git add` the result.' >&2; exit 1; }
      """
  }
  // THE PINS ARE TAGS (V44). A flake input that follows a branch moves the
  // rules this gate enforces with no diff to read, so every `url` line in
  // flake.nix must end in a `vX.Y.Z` tag. The two fleet authorities are
  // exempt by NAME, because they are pinned by their own lock.
  //
  // It fails CLOSED on shape: a `url` line it cannot read -- an attribute
  // set form, a `?ref=` query, a bare repo -- is refused rather than
  // passed, so a new spelling cannot slip a branch past it.
  ["flake-tags"] {
    glob = List("flake.nix")
    check = """
      awk '
        /url *=/ {
          seen++
          if (match($0, /^ *[A-Za-z0-9_-]+[.]url *= *"[^"]*" *; *$/) == 0) { print "flake.nix:" NR ": cannot read this url line"; bad++; next }
          name = $0; sub(/^ */, "", name); sub(/[.]url.*/, "", name)
          if (name == "nixpkgs-lock" || name == "nix-hk") next
          if ($0 !~ /[/]v[0-9]+[.][0-9]+[.][0-9]+" *; *$/) { print "flake.nix:" NR ": " name " does not pin a vX.Y.Z tag"; bad++ }
        }
        END { if (seen == 0) { print "flake.nix: no url line examined"; bad++ } exit bad > 0 }
      ' flake.nix >&2 || { echo 'hk: a flake input is not pinned to a tag (V44). Pin `github:owner/repo/vX.Y.Z` and bump it in its own reviewed commit; following a branch is rejected.' >&2; exit 1; }
      """
  }
  // GENERATED DATA STAYS GENERATED (`src/charset:V97`). The emoji sequence
  // map is the one generated file whose input is vendored, so it is the one
  // this gate can regenerate with no network: run the generator, diff its
  // output against the committed file. A hand edit, or a generator change
  // that was not rerun, fails here. The online steps (`fetch`) are not
  // gated -- the gate runs offline (`.:C`).
  ["emoji-seq-map"] {
    glob = List("src/charset/emoji-sequences.sh", "src/charset/emoji-sequences.txt", "src/fix/emoji/emoji-seq.ctrm-map")
    check = """
      mkdir -p target
      sh src/charset/emoji-sequences.sh map > target/emoji-seq.ctrm-map || { echo 'hk: `sh src/charset/emoji-sequences.sh map` failed, so the emoji sequence map was NOT checked. Examined nothing; this is not a pass.' >&2; exit 1; }
      diff -u src/fix/emoji/emoji-seq.ctrm-map target/emoji-seq.ctrm-map >&2 || { echo 'hk: src/fix/emoji/emoji-seq.ctrm-map is not what `sh src/charset/emoji-sequences.sh map > src/fix/emoji/emoji-seq.ctrm-map` writes from the vendored sequences. Regenerate it; never edit it by hand (src/charset:V97).' >&2; exit 1; }
      """
  }
  // THE HOOK INSTALL IS GUARDED (V40, B1). The dev shell may be entered
  // from a sibling repo to borrow a tool, and once installed our hooks over
  // its tracked ones. The shellHook's two guards -- the crate-name marker
  // at the worktree root, and the refusal of a TRACKED hooks dir -- must
  // both appear, in that order, before any `install` of a hook.
  //
  // A text check, and the cheapest honest one: running the shellHook in a
  // scratch sibling repo would need nix inside the gate. It catches a
  // guard deleted or moved below the installs, which is how B1 happened;
  // it cannot prove the guards' shell logic right.
  ["hook-guard"] {
    glob = List("flake.nix")
    check = """
      marker='^name = "characterminator"$'
      tracked='ls-files --error-unmatch "$ctrm_hooks"'
      awk -v m="$marker" -v t="$tracked" '
        index($0, m) && !lm { lm = NR }
        index($0, t) && !lt { lt = NR }
        index($0, "install -m 755") { n++; if (!li) li = NR }
        END { exit !(lm && lt && li && lm < lt && lt < li && n == 2) }
      ' flake.nix || { echo 'hk: flake.nix shellHook must check the crate-name marker, then refuse a tracked hooks dir, BEFORE it installs either hook (V40, B1). One of the guards is missing or sits below an install.' >&2; exit 1; }
      """
  }
  // THE BADGE READS THE CLAIM (V46). The coverage figure in README.md is
  // copied from `.coverage`, never typed, so a badge cannot say one number
  // while the file the gate keeps honest says another.
  //
  // It lives in the FAST set because it only compares two files already on
  // disk: a hand edit to either is caught at pre-commit, long before the
  // instrumented build in pre-push would notice.
  //
  // Colour is fixed at brightgreen: the floor in the `coverage` step already
  // refuses anything low enough to deserve another.
  ["coverage-badge"] {
    glob = List("README.md", ".coverage")
    check = """
      claim=$(awk '/^lines /{printf "%.1f", $2}' .coverage)
      want="[![coverage $claim%](https://img.shields.io/badge/coverage-$claim%25-brightgreen)](.coverage)"
      grep -qxF "$want" README.md || { echo "hk: .coverage claims $claim% but README.md has no badge saying so. Run 'hk run fix' -- the badge is copied from .coverage, never typed." >&2; exit 1; }
      """
    fix = """
      claim=$(awk '/^lines /{printf "%.1f", $2}' .coverage)
      mkdir -p target
      awk -v c="$claim" 'index($0, "[![coverage ") == 1 {print "[![coverage " c "%](https://img.shields.io/badge/coverage-" c "%25-brightgreen)](.coverage)"; next} {print}' README.md > target/README.new
      mv target/README.new README.md
      """
  }
}

/// The full set adds line coverage (V46), which pre-commit does not run.
///
/// It costs an instrumented build, and the point of pre-commit is that it
/// is cheap enough that nobody reaches for `--no-verify`. Pre-push and CI
/// are where a slower truth belongs.
local all = (fast) {
  ["coverage"] {
    glob = List("src/**", ".coverage")
    depends = List("test")
    check = """
      command -v cargo-llvm-cov >/dev/null 2>&1 || { echo 'hk: cargo-llvm-cov is not on PATH, so coverage was NOT measured -- re-enter the dev shell. Examined nothing; this is not a pass.' >&2; exit 1; }
      rustc_llvm=$(rustc -vV | awk '/^LLVM version:/{split($3,a,"."); print a[1]}')
      tool_llvm=$(llvm-profdata --version | awk '/LLVM version/{split($3,a,"."); print a[1]}')
      if test "$rustc_llvm" != "$tool_llvm"; then
        echo "hk: rustc was built against LLVM $rustc_llvm but llvm-profdata is $tool_llvm. Coverage data would fail to parse and it would read as a broken test. Update coverageLlvm in flake.nix to match (V46)." >&2
        exit 1
      fi
      mkdir -p target
      cargo llvm-cov --summary-only --fail-under-lines 93 > target/coverage.txt || { cat target/coverage.txt >&2; echo 'hk: below the coverage FLOOR. Cover the gap; lowering the floor is a reviewed decision and belongs in its own commit.' >&2; exit 1; }
      cat target/coverage.txt
      measured=$(awk '/^TOTAL/{gsub("%","",$10); printf "%.1f", int($10*10)/10}' target/coverage.txt)
      claim=$(awk '/^lines /{printf "%.1f", $2}' .coverage)
      if awk -v m="$measured" -v c="$claim" 'BEGIN{exit !(m+0 < c+0)}'; then
        echo "hk: .coverage claims $claim% and this machine measures $measured%, so the README badge OVERSTATES coverage. Run 'hk run fix', then stage .coverage and the README." >&2
        exit 1
      fi
      if awk -v m="$measured" -v c="$claim" 'BEGIN{exit !(m+0 - c+0 > 0.5)}'; then
        echo "hk: .coverage claims $claim% and this machine measures $measured%, more than half a point above it. The badge is not wrong, only stale -- run 'hk run fix' to take the credit." >&2
        exit 1
      fi
      """
    fix = """
      mkdir -p target
      cargo llvm-cov --summary-only --fail-under-lines 93 > target/coverage.txt || { cat target/coverage.txt >&2; exit 1; }
      measured=$(awk '/^TOTAL/{gsub("%","",$10); printf "%.1f", int($10*10)/10}' target/coverage.txt)
      key=$(git ls-files -s -- src | git hash-object --stdin)
      awk -v k="$key" -v m="$measured" '/^key /{print "key " k; next} /^lines /{print "lines " m; next} {print}' .coverage > target/coverage.new
      mv target/coverage.new .coverage
      """
  }
  // Measured first, so in fix mode the badge is rewritten from the figure
  // this run just wrote rather than from the one it replaced.
  ["coverage-badge"] {
    depends = List("coverage")
  }
}

/// The pre-commit set adds the branch guard. Never commit to main: the
/// server-side rule is the one that actually defends the branch and this is
/// the courtesy that catches it earlier.
local precommit = (fast) {
  ["no-commit-to-branch"] {
    glob = List("**/*")
    check = "hk util no-commit-to-branch --branch main"
  }
}

hooks {
  /// `stash = "git"` is correctness, not speed: without it a partially
  /// staged file (`git add -p`) is checked as it looks in the worktree,
  /// giving a verdict about code you are not committing.
  ///
  /// Installed by `flake.nix`'s shellHook, BY HAND rather than by
  /// `hk install`, so a shell without hk REFUSES with an instruction --
  /// enter the dev shell -- instead of failing with "command not found".
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = precommit
  }
  ["pre-push"] {
    steps = all
  }
  /// What `hk check` runs -- the CI entry point.
  ["check"] {
    steps = all
  }
  ["fix"] {
    fix = true
    steps = all
  }
}
